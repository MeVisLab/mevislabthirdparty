+[[nodiscard]] QEvent* mevis_cloneAndClearQMetaCallEvent(QEvent* event) noexcept
+{
+    if (event->type() != QEvent::MetaCall) {
+        return nullptr;
+    }
+
+    auto* metaCallEvent = static_cast<QMetaCallEvent*>(event);
+
+    // Blocking calls have nargs_==0
+    if (metaCallEvent->d.nargs_ == 0) {
+        QMetaCallEvent* newEvent = nullptr;
+        if (metaCallEvent->d.slotObj_) {
+            newEvent = new (std::nothrow) QMetaCallEvent(
+                std::move(metaCallEvent->d.slotObj_), metaCallEvent->sender(),
+                metaCallEvent->signalId(), metaCallEvent->d.args_, metaCallEvent->latch);
+        }
+        else {
+            newEvent = new (std::nothrow) QMetaCallEvent(
+                metaCallEvent->d.method_offset_, metaCallEvent->d.method_relative_,
+                metaCallEvent->d.callFunction_, metaCallEvent->sender(),
+                metaCallEvent->signalId(), metaCallEvent->d.args_, metaCallEvent->latch);
+        }
+
+        if (!newEvent) {
+            return nullptr;
+        }
+
+        metaCallEvent->latch = nullptr;
+        return newEvent;
+    }
+
+    // This is a QQueuedMetaCallEvent - queued call with copied arguments
+    auto* srcEvent = static_cast<QQueuedMetaCallEvent*>(metaCallEvent);
+    const auto nargs = srcEvent->d.nargs_;
+
+    // Create new event, transferring slotObj_ ownership via std::move
+    QQueuedMetaCallEvent* newEvent = nullptr;
+    if (srcEvent->d.slotObj_) {
+        newEvent = new (std::nothrow) QQueuedMetaCallEvent(
+            std::move(srcEvent->d.slotObj_), srcEvent->sender(),
+            srcEvent->signalId(), 0, nullptr, nullptr);
+    }
+    else {
+        newEvent = new (std::nothrow) QQueuedMetaCallEvent(
+            srcEvent->d.method_offset_, srcEvent->d.method_relative_,
+            srcEvent->d.callFunction_, srcEvent->sender(),
+            srcEvent->signalId(), 0, nullptr, nullptr);
+    }
+
+    if (!newEvent) {
+        return nullptr;
+    }
+
+    // Get type information array (located after args pointers)
+    auto* srcTypes = reinterpret_cast<QMetaType*>(srcEvent->d.args_ + nargs);
+    const bool argsInPrealloc = (static_cast<void*>(srcEvent->d.args_) == static_cast<void*>(srcEvent->prealloc_));
+
+    if (argsInPrealloc) {
+        // Args/types array is in prealloc_ - set up newEvent's prealloc_
+        newEvent->d.args_ = reinterpret_cast<void**>(newEvent->prealloc_);
+        newEvent->d.nargs_ = nargs;
+
+        auto* newTypes = reinterpret_cast<QMetaType*>(newEvent->d.args_ + nargs);
+
+        // Copy arg pointers
+        for (int i = 0; i < nargs; ++i) {
+            newEvent->d.args_[i] = srcEvent->d.args_[i];
+        }
+
+        // Copy-construct QMetaType objects (they are not trivially copyable)
+        for (int i = 0; i < nargs; ++i) {
+            new (&newTypes[i]) QMetaType(srcTypes[i]);
+        }
+    }
+    else {
+        // Args/types array is heap-allocated - transfer ownership directly
+        newEvent->d.args_ = srcEvent->d.args_;
+        newEvent->d.nargs_ = nargs;
+        srcEvent->d.args_ = nullptr;
+        srcEvent->d.nargs_ = 0;
+    }
+
+    // Transfer in-place argument values from valuesPrealloc_
+    int inplaceIndex = 0;
+    for (int i = 0; i < nargs; ++i) {
+        void* argPtr = srcEvent->d.args_[i];
+        if (!argPtr) {
+            continue;
+        }
+
+        const auto* preallocStart = reinterpret_cast<const char*>(&srcEvent->valuesPrealloc_[0]);
+        const auto* preallocEnd = reinterpret_cast<const char*>(&srcEvent->valuesPrealloc_[QQueuedMetaCallEvent::InplaceValuesCapacity]);
+        if (argPtr >= preallocStart && argPtr < preallocEnd) {
+            void* srcWhere = &srcEvent->valuesPrealloc_[inplaceIndex].storage;
+            void* dstWhere = &newEvent->valuesPrealloc_[inplaceIndex].storage;
+
+            if (srcTypes[i].isValid()) {
+                srcTypes[i].construct(dstWhere, srcWhere);
+                srcTypes[i].destruct(srcWhere);
+            }
+
+            newEvent->d.args_[i] = dstWhere;
+            ++inplaceIndex;
+        }
+    }
+
+    // Clear source event to prevent destructor from freeing transferred resources
+    if (argsInPrealloc) {
+        // Destruct QMetaType objects in source (they were copied, not moved)
+        for (int i = 0; i < nargs; ++i) {
+            srcTypes[i].~QMetaType();
+        }
+    }
+    srcEvent->d.args_ = nullptr;
+    srcEvent->d.nargs_ = 0;
+
+    return newEvent;
+}
