-cpp_library_set_version()
+if(NOT STLAB_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
+  message(FATAL_ERROR "STLAB_VERSION must be set to a x.y.z version number.")
+endif()
+set(PROJECT_VERSION ${STLAB_VERSION})
+string(REPLACE "." ";" STLAB_VERSION_COMPONENTS ${STLAB_VERSION})
+list(GET STLAB_VERSION_COMPONENTS 0 PROJECT_VERSION_MAJOR)
+list(GET STLAB_VERSION_COMPONENTS 1 PROJECT_VERSION_MINOR)
+list(GET STLAB_VERSION_COMPONENTS 2 PROJECT_VERSION_PATCH)
 
